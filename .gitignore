# ============================================================
# .gitignore - Cinema Booking Project
# ============================================================

# -------------------------------------------------------
# .NET / ASP.NET Core Backend
# -------------------------------------------------------

# Build output
bin/
obj/
out/
build/
publish/

# Visual Studio
.vs/
*.suo
*.user
*.userprefs
*.userosscache
*.sln.docstates

# Rider
.idea/

# NuGet
*.nupkg
*.snupkg
packages/*
!packages/repositories.config
*.lock.json
project.lock.json
project.fragment.lock.json

# Test results
TestResults/
coverage/
*.coverage
*.coveragexml

# Publish output
PublishProfiles/

# Entity Framework migrations (keep Migrations folder but ignore snapshots if desired)
# Uncomment if you don't want to track migrations:
# */Migrations/

# -------------------------------------------------------
# SENSITIVE CONFIGURATION - NEVER COMMIT THESE!
# -------------------------------------------------------
appsettings.json
appsettings.*.json
!appsettings.example.json
secrets.json
*.pem
*.key
*.pfx
*.p12
.env
.env.*
!.env.example

# -------------------------------------------------------
# Node.js / React Frontend
# -------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
build/
*.local

# Vite
.vite/

# -------------------------------------------------------
# Logs & Debug
# -------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -------------------------------------------------------
# OS & Editor Files
# -------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Visual Studio Code
.vscode/
.history/

# JetBrains
.idea/
*.iml

# -------------------------------------------------------
# Misc
# -------------------------------------------------------
*.swp
*.swo
*.tmp
*.bak
*~
.cache/

# TypeScript
*.tsbuildinfo
